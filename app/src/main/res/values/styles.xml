<resources>
    <!-- Shared text and component styles (MM.* styles inherit from this empty base) -->
    <style name="MM" />

    <!-- Large white title on the sky, with a soft shadow so it stays readable on light clouds -->
    <style name="MM.Title">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:shadowColor">#663B2E5A</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">12</item>
    </style>

    <style name="MM.Heading">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/mm_ink</item>
    </style>

    <style name="MM.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/mm_muted</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="MM.Card">
        <item name="android:background">@drawable/mm_card</item>
        <item name="android:padding">24dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="MM.Field">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/mm_field</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="MM.FieldIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:tint">@color/mm_muted</item>
    </style>

    <style name="MM.FieldInput">
        <item name="android:background">@null</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/mm_ink</item>
        <item name="android:textColorHint">@color/mm_muted</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="MM.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/mm_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="MM.Button.Secondary">
        <item name="android:background">@drawable/mm_button_secondary</item>
        <item name="android:textColor">@color/mm_primary</item>
    </style>

    <style name="MM.IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">13dp</item>
        <item name="android:background">@drawable/mm_icon_button</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/mm_ink</item>
    </style>
</resources>
