<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_image"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/appTitle"
            style="@style/MM.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MoodMate!" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="MoodMate logo"
            android:src="@drawable/moodmate_logo" />

        <LinearLayout
            style="@style/MM.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/MM.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textSize="24sp" />

            <TextView
                style="@style/MM.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Log in to check in with yourself." />

            <LinearLayout
                style="@style/MM.Field"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    style="@style/MM.FieldIcon"
                    android:src="@drawable/ic_user" />

                <EditText
                    android:id="@+id/usernameInput"
                    style="@style/MM.FieldInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Username" />
            </LinearLayout>

            <LinearLayout
                style="@style/MM.Field"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp">

                <ImageView
                    style="@style/MM.FieldIcon"
                    android:src="@drawable/ic_lock" />

                <EditText
                    android:id="@+id/passwordInput"
                    style="@style/MM.FieldInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Password"
                    android:inputType="textPassword" />
            </LinearLayout>

            <!-- Show Password Switch -->
            <Switch
                android:id="@+id/showPasswordSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Show password  "
                android:textColor="@color/mm_muted"
                android:textSize="15sp" />

            <!-- Login Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/loginButton"
                style="@style/MM.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Log in" />

            <!-- Sign Up Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/signUpButton"
                style="@style/MM.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Create an account" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
